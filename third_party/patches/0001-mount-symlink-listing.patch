+// CreateSymlink creates leaf in this directory as a symbolic link to oldname.
+//
+// It returns EEXIST if leaf already exists and ENOSYS if --links is not set.
+func (d *Dir) CreateSymlink(oldname, leaf string) (Node, error) {
+	if !d.vfs.Opt.Links {
+		fs.Errorf(d.path, "symlinks not supported without the --links flag")
+		return nil, ENOSYS
+	}
+	// Destination can't exist
+	if _, err := d.Stat(leaf); err == nil {
+		return nil, EEXIST
+	} else if err != ENOENT {
+		return nil, err
+	}
+	// Create the file node
+	flags := os.O_WRONLY | os.O_CREATE | os.O_TRUNC | o_SYMLINK
+	file, err := d.Create(leaf, flags)
+	if err != nil {
+		return nil, err
+	}
+	// Force the file to be a link
+	file.setSymlink()
+	// Open the file
+	fh, err := file.Open(flags)
+	if err != nil {
+		return nil, err
+	}
+	defer fs.CheckClose(fh, &err)
+	// Write the symlink data
+	_, err = fh.Write([]byte(strings.ReplaceAll(oldname, "\\", "/")))
+	return file, nil
+}
+
