+// backendEntry returns the fs.Directory backing this node.
+//
+// Synthetic entries (fs.NewDir from Mkdir/Rename) can't read or write
+// metadata, so the real directory is re-read from the parent once. Call
+// without d.mu held.
+func (d *Dir) backendEntry() fs.Directory {
+	d.mu.RLock()
+	entry, parent, dirPath, synthetic := d.entry, d.parent, d.path, d.synthetic
+	d.mu.RUnlock()
+	if entry == nil || !synthetic || parent == nil {
+		return entry
+	}
+	parentPath := path.Dir(dirPath)
+	if parentPath == "." {
+		parentPath = ""
+	}
+	entries, err := d.f.List(d.vfs.ctx, parentPath)
+	if err != nil {
+		fs.Debugf(dirPath, "Dir.backendEntry: failed to list %q: %v", parentPath, err)
+		return entry
+	}
+	for _, e := range entries {
+		dir, ok := e.(fs.Directory)
+		if !ok || dir.Remote() != dirPath {
+			continue
+		}
+		d.mu.Lock()
+		if d.path == dirPath { // not renamed while listing
+			d.entry, d.synthetic = dir, false
+			entry = dir
+		}
+		d.mu.Unlock()
+		return entry
+	}
+	return entry
+}
+
+// Metadata returns the POSIX metadata of the directory if its
+// fs.Directory supports reading metadata.
+func (d *Dir) Metadata(ctx context.Context) (fs.Metadata, error) {
+	entry := d.backendEntry()
+	if entry == nil {
+		return nil, ENOSYS
+	}
+	if do, ok := entry.(fs.Metadataer); ok {
+		return do.Metadata(ctx)
+	}
+	return nil, ENOSYS
+}
+
+// SetMetadata sets POSIX metadata on the directory if its
