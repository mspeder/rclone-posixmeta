+//go:build linux
+
+package mount
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+
+	"bazil.org/fuse"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/vfs"
+)
+
+// applyPOSIXMetadata overrides the mount-wide default mode, uid and gid in
+// attr with per-entry POSIX metadata from the backend (so ls -l/stat show
+// what posixmeta stored instead of --file-perms/--dir-perms and --uid/--gid).
+//
+// modeFromMeta must be false for symlinks: their mode comes from
+// --link-perms (the kernel ignores chmod on links), so a stored "mode" would
+// make stat report e.g. 0644. uid/gid are still overlaid.
+func applyPOSIXMetadata(attr *fuse.Attr, meta fs.Metadata, modeFromMeta bool) {
+	if len(meta) == 0 {
+		return
+	}
+	if v, ok := meta["mode"]; ok && modeFromMeta {
+		if mode, ok := parsePOSIXMode(v); ok {
+			const permBits = os.ModePerm | os.ModeSetuid | os.ModeSetgid | os.ModeSticky
+			attr.Mode = (attr.Mode &^ permBits) | mode
+		}
+	}
+	if v, ok := meta["uid"]; ok {
+		if uid, err := strconv.ParseUint(strings.TrimSpace(v), 10, 32); err == nil {
+			attr.Uid = uint32(uid)
+		}
+	}
+	if v, ok := meta["gid"]; ok {
+		if gid, err := strconv.ParseUint(strings.TrimSpace(v), 10, 32); err == nil {
+			attr.Gid = uint32(gid)
+		}
+	}
+}
+
+// posixMetadataWriter is implemented by *vfs.File and *vfs.Dir.
+type posixMetadataWriter interface {
+	SetMetadata(ctx context.Context, meta fs.Metadata) error
+}
+
+// posixMetadataReader is implemented by *vfs.File and *vfs.Dir.
+type posixMetadataReader interface {
+	Metadata(ctx context.Context) (fs.Metadata, error)
+}
+
+// setattrPOSIX pushes the mode/uid/gid of a FUSE setattr request to the
+// backend through node.
+//
+// ENOSYS (a backend without metadata support) is swallowed to keep
+// rclone's historical behaviour of ignoring chmod/chown.
+func setattrPOSIX(ctx context.Context, node posixMetadataWriter, req *fuse.SetattrRequest) error {
+	var meta fs.Metadata
+	if req.Valid.Mode() {
+		meta.Set("mode", modeToMetadata(req.Mode))
+	}
+	if req.Valid.Uid() {
+		meta.Set("uid", strconv.FormatUint(uint64(req.Uid), 10))
+	}
+	if req.Valid.Gid() {
+		meta.Set("gid", strconv.FormatUint(uint64(req.Gid), 10))
+	}
+	if len(meta) == 0 {
+		return nil
+	}
+	err := node.SetMetadata(ctx, meta)
+	if errors.Is(err, vfs.ENOSYS) {
+		return nil
+	}
+	return err
+}
+
+// modeToMetadata converts an os.FileMode into the octal string used by
+// fs.Metadata ("0%o"), including the setuid, setgid and sticky bits.
+func modeToMetadata(mode os.FileMode) string {
+	v := uint32(mode.Perm())
+	if mode&os.ModeSetuid != 0 {
+		v |= 0o4000
+	}
+	if mode&os.ModeSetgid != 0 {
+		v |= 0o2000
+	}
+	if mode&os.ModeSticky != 0 {
+		v |= 0o1000
+	}
+	return fmt.Sprintf("0%o", v)
+}
+
+// createKind is the kind of entry being created through the mount. It decides
+// which POSIX attributes may be stamped: S_ISGID is inherited by new
+// subdirectories only, and symlinks keep their mode from --link-perms.
+type createKind int
+
+const (
+	createFile createKind = iota // regular file or device node
+	createDir                    // directory
+	createLink                   // symlink
+)
+
+// posixCreateMetadata builds the metadata to stamp on a new entry so it looks
+// like a freshly created inode on a regular filesystem:
+//
+//   - uid = the creating process;
+//   - gid = the creating process, unless the parent directory has S_ISGID (then
+//     the parent's group wins);
+//   - mode = the mode the kernel asked for (already masked by the caller's
+//     umask, because bazil/fuse doesn't negotiate FUSE_DONT_MASK), plus the
+//     parent's S_ISGID bit for new subdirectories. Regular files never inherit
+//     S_ISGID, and symlinks take their mode from --link-perms (Linux ignores
+//     chmod on links), so for createLink only uid/gid are recorded.
+//
+// Without this a fresh entry would resolve to default_uid/default_gid, the
+// parent's owner and default_file_mode/default_dir_mode instead of the
+// caller's credentials and umask.
+func posixCreateMetadata(ctx context.Context, parent *vfs.Dir, kind createKind, reqMode os.FileMode, uid, gid uint32) fs.Metadata {
+	meta := fs.Metadata{
+		"uid": strconv.FormatUint(uint64(uid), 10),
+		"gid": strconv.FormatUint(uint64(gid), 10),
+	}
+	if kind != createLink {
+		meta["mode"] = modeToMetadata(reqMode)
+	}
+	if parent == nil {
+		return meta
+	}
+	pmeta, err := parent.Metadata(ctx)
+	if err != nil {
+		return meta
+	}
+	pmode, ok := parsePOSIXMode(pmeta["mode"])
+	if !ok || pmode&os.ModeSetgid == 0 {
+		return meta
+	}
+	if pgid, err := strconv.ParseUint(strings.TrimSpace(pmeta["gid"]), 10, 32); err == nil {
+		meta["gid"] = strconv.FormatUint(pgid, 10)
+	}
+	if kind == createDir {
+		meta["mode"] = modeToMetadata(reqMode | os.ModeSetgid)
+	}
+	return meta
+}
+
+// parsePOSIXMode parses an octal mode string such as "0644" or "0o755"
+// into an os.FileMode including the setuid, setgid and sticky bits.
+func parsePOSIXMode(s string) (os.FileMode, bool) {
+	s = strings.TrimSpace(s)
+	s = strings.TrimPrefix(s, "0o")
+	s = strings.TrimPrefix(s, "0O")
+	if s == "" {
+		return 0, false
+	}
+	value, err := strconv.ParseUint(s, 8, 32)
+	if err != nil {
+		return 0, false
+	}
+	mode := os.FileMode(value & 0o777)
+	if value&0o4000 != 0 {
+		mode |= os.ModeSetuid
+	}
+	if value&0o2000 != 0 {
+		mode |= os.ModeSetgid
+	}
+	if value&0o1000 != 0 {
+		mode |= os.ModeSticky
+	}
+	return mode, true
+}
