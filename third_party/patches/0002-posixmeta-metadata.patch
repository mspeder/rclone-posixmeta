+	if entry == nil {
+		return ENOSYS
+	}
+	do, ok := entry.(fs.SetMetadataer)
+	if !ok {
+		return ENOSYS
+	}
+	return do.SetMetadata(d.vfs.ctx, meta) // outlives the FUSE request ctx
+}
