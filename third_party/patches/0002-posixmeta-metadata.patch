+// Metadata returns the POSIX metadata of the file if its object supports
+// reading metadata, with any values queued by SetMetadata overlaid so getattr
+// reflects a chmod/chown issued while the file is still being written.
+//
+// It returns ENOSYS if no metadata is available.
+func (f *File) Metadata(ctx context.Context) (fs.Metadata, error) {
+	f.mu.RLock()
+	o := f.o
+	pending := maps.Clone(f.pendingMetadata)
+	f.mu.RUnlock()
+
+	var meta fs.Metadata
+	if o != nil {
+		if do, ok := o.(fs.Metadataer); ok {
+			m, err := do.Metadata(ctx)
+			if err != nil {
+				return nil, err
+			}
+			meta = m
+		}
+	}
+	meta.Merge(pending)
+	if meta == nil {
+		return nil, ENOSYS
+	}
+	return meta, nil
+}
+
+// SetMetadata sets POSIX metadata on the file via its object if it supports
+// fs.SetMetadataer. While the file is still being written the metadata is
+// queued and applied from setObject once the object exists.
+func (f *File) SetMetadata(ctx context.Context, meta fs.Metadata) error {
+	if f.d.vfs.Opt.ReadOnly {
+		return EROFS
+	}
+	if len(meta) == 0 {
+		return nil
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.pendingMetadata == nil {
+		f.pendingMetadata = make(fs.Metadata, len(meta))
+	}
+	for k, v := range meta {
+		f.pendingMetadata[k] = v
+	}
+	if f._writingInProgress() {
+		return nil
+	}
+	return f._applyPendingMetadata(f.ctx) // outlives the FUSE request ctx
+}
+
+// Apply pending metadata
+//
+// Call with the mutex held and the object available
+func (f *File) _applyPendingMetadata(ctx context.Context) error {
+	if len(f.pendingMetadata) == 0 {
+		return nil
+	}
+	pending := f.pendingMetadata
+	f.pendingMetadata = nil
+	do, ok := f.o.(fs.SetMetadataer)
+	if !ok {
+		return ENOSYS
+	}
+	err := do.SetMetadata(ctx, pending)
+	if err != nil {
+		fs.Errorf(f._path(), "Failed to apply pending metadata %v: %v", pending, err)
+		// Put the metadata back so a later attempt can retry.
+		f.pendingMetadata = pending
+	}
+	return err
+}
