+// modeToMetadata converts an os.FileMode into the octal string used by
+// fs.Metadata ("0%o"), including the setuid, setgid and sticky bits.
+func modeToMetadata(mode os.FileMode) string {
+	v := uint32(mode.Perm())
+	if mode&os.ModeSetuid != 0 {
