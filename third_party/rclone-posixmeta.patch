+// applyPOSIXMetadata overrides the mount wide default mode, uid and gid
+// in attr with per-entry POSIX metadata when the backend provides it.
+//
+// This lets `ls -l` and `stat` inside the mount show the values stored
+// by backends such as posixmeta instead of --file-perms/--dir-perms and
+// --uid/--gid.
+//
+// modeFromMeta must be false for symlinks. Their mode comes from
+// --link-perms (0777 plus the symlink type bit) and the kernel ignores
+// chmod on symlinks, so applying a stored "mode" attribute would make
+// `stat` report e.g. 0644 for a link. uid/gid are still overlaid so
+// inherited owners are visible for links too.
+func applyPOSIXMetadata(attr *fuse.Attr, meta fs.Metadata, modeFromMeta bool) {
+	if len(meta) == 0 {
+		return
+	}
+	if v, ok := meta["mode"]; ok && modeFromMeta {
+		if mode, ok := parsePOSIXMode(v); ok {
+			const permBits = os.ModePerm | os.ModeSetuid | os.ModeSetgid | os.ModeSticky
+			attr.Mode = (attr.Mode &^ permBits) | mode
+		}
+	}
+	if v, ok := meta["uid"]; ok {
+		if uid, err := strconv.ParseUint(strings.TrimSpace(v), 10, 32); err == nil {
+			attr.Uid = uint32(uid)
+		}
+	}
+	if v, ok := meta["gid"]; ok {
+		if gid, err := strconv.ParseUint(strings.TrimSpace(v), 10, 32); err == nil {
+			attr.Gid = uint32(gid)
+		}
+	}
+}
+
+// parsePOSIXMode parses an octal mode string such as "0644" or "0o755"
+// into an os.FileMode including the setuid, setgid and sticky bits.
+func parsePOSIXMode(s string) (os.FileMode, bool) {
+	s = strings.TrimSpace(s)
+	s = strings.TrimPrefix(s, "0o")
+	s = strings.TrimPrefix(s, "0O")
+	if s == "" {
+		return 0, false
+	}
+	value, err := strconv.ParseUint(s, 8, 32)
+	if err != nil {
+		return 0, false
+	}
+	mode := os.FileMode(value & 0o777)
+	if value&0o4000 != 0 {
+		mode |= os.ModeSetuid
+	}
+	if value&0o2000 != 0 {
+		mode |= os.ModeSetgid
+	}
+	if value&0o1000 != 0 {
+		mode |= os.ModeSticky
+	}
+	return mode, true
+}
