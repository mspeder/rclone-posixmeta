+// backendEntry returns the fs.Directory backing this node.
+//
+// Directories created with Mkdir, or renamed, hold a synthetic
+// fs.Dir which can't read or write metadata. For those the real
+// directory entry is re-read from the backend so that metadata
+// operations work immediately rather than only after the directory
+// cache expires.
+//
+// Call without d.mu held.
+func (d *Dir) backendEntry(ctx context.Context) fs.Directory {
+	d.mu.RLock()
+	entry := d.entry
+	parent := d.parent
+	dirPath := d.path
+	synthetic := d.synthetic
+	d.mu.RUnlock()
+	if entry == nil {
+		return nil
+	}
+	// Only synthetic entries need refreshing - they are made with
+	// fs.NewDir/fs.NewDirCopy and can't read or write metadata.
+	if !synthetic {
+		return entry
+	}
+	// The root directory entry can't be re-read from a parent.
+	if parent == nil {
+		return entry
+	}
+	parentPath := path.Dir(dirPath)
+	if parentPath == "." {
+		parentPath = ""
+	}
+	entries, err := d.f.List(d.vfs.ctx, parentPath)
+	if err != nil {
+		fs.Debugf(dirPath, "Dir.backendEntry: failed to list %q: %v", parentPath, err)
+		return entry
+	}
+	for _, e := range entries {
+		if dir, ok := e.(fs.Directory); ok && dir.Remote() == dirPath {
+			d.mu.Lock()
+			// Don't overwrite the entry if the directory was renamed
+			// while we were listing the parent.
+			if d.path == dirPath {
+				d.entry = dir
+				d.synthetic = false
+				entry = dir
+			}
+			d.mu.Unlock()
+			return entry
+		}
+	}
+	return entry
+}
